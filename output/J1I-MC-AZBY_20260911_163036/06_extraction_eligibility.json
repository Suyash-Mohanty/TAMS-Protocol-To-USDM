      "entity_type": "criterion_item",
      "data": {
        "id": "eci_6",
        "name": "Stable weight prior to screening",
        "text": "Are of stable weight (self-reported change ≤5 kg or 11 pounds) for at least 90 days prior to Visit 1 and agree to not initiate an intensive diet or exercise program during the study with the intent of reducing body weight other than the lifestyle and/or dietary measures for diabetes treatment.",
