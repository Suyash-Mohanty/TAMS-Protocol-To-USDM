      "entity_type": "criterion_item",
      "data": {
        "id": "eci_5",
        "name": "Motivation and ability to follow study procedures",
        "text": "Are motivated and willing to make themselves available for the duration of the study and are able to follow study procedures as required, including: store provided study intervention as directed; perform SMBG per protocol; maintain a study eDiary; complete patient questionnaires; and self-inject study intervention. Note: Persons with physical limitations who are not able to perform the injections must have the assistance of an individual trained to inject the intervention.",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
