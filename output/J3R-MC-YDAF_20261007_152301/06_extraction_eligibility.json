      "data": {
        "id": "eci_4",
        "name": "BMI requirement",
        "text": "Have a BMI >27 kg/m2 at Visit 1. Note: In participants with limb amputation or limb loss, the investigator should reach out to the Lilly medical monitor for information regarding calculation of BMI.",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
