      "entity_type": "criterion_item",
      "data": {
        "id": "eci_3",
        "name": "Stable T2D treatment",
        "text": "Are on stable treatment for T2D for at least 90 days prior to screening (Visit 1), consisting of either diet/exercise alone or up to 3 oral AHMs (excluding incretins). Note: DPP-4i are allowed.",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
