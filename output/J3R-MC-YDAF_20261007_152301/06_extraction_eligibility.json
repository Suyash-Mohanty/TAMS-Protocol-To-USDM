      "entity_type": "criterion_item",
      "data": {
        "id": "eci_2",
        "name": "Type 2 diabetes diagnosis",
        "text": "Have a clinical diagnosis of T2D according to the World Health Organization (WHO) classification or other locally applicable standards for at least 6 months prior to screening (Visit 1), with HbA1c ≤10.0% (86 mmol/mol) at screening (Visit 1).",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
      "source_pages": [
