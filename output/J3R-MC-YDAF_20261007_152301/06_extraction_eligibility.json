    {
      "id": "eci_9",
      "entity_type": "criterion_item",
      "data": {
        "id": "eci_9",
        "name": "Reliability and willingness to comply",
        "text": "Are reliable and willing to make themselves available for the duration of the study and attend required study visits, and are willing and able to follow study procedures as required, such as self-inject study intervention; store and take the provided study intervention as directed; maintain electronic study diary and paper log; complete the required questionnaires; and undergo DXA procedure. Note: if a person is unable to undergo the DXA due to physical limitations of the DXA machine, or because they have implants, hardware, or other foreign materials that may interfere with the scan according to the DXA manufacturer's specification, this will not be considered an exclusionary criterion. See Section 8.1.2 for further details.",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
      "source_pages": [
