      "entity_type": "criterion_item",
      "data": {
        "id": "eci_11",
        "name": "Prior or planned endoscopic/device-based therapy for obesity",
        "text": "Have a prior or planned endoscopic procedure and/or device-based therapy for obesity, such as, but not limited to mucosal ablation; gastric artery embolization; laparoscopic adjustable gastric banding; intragastric balloon; or duodenal-jejunal endoluminal liner. Exception: Prior device-based therapy is acceptable if device removal was more than 6 months prior to screening (Visit 1).",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
      "source_pages": [
