    },
    {
      "id": "eci_10",
      "entity_type": "criterion_item",
      "data": {
        "id": "eci_10",
        "name": "Prior or planned surgical treatment for obesity",
        "text": "Have a prior or planned surgical treatment for obesity. Exception: The following are allowed if performed >1 year before screening (Visit 1): liposuction; cryolipolysis; or abdominoplasty.",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
      "source_pages": [
        15,
