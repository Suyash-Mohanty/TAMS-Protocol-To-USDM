    },
    {
      "id": "eci_8",
      "entity_type": "criterion_item",
      "data": {
        "id": "eci_8",
        "name": "Informed consent capability",
        "text": "Are capable of giving signed informed consent as described in Appendix 1, which includes compliance with the requirements and restrictions listed in the ICF and in this protocol.",
        "instanceType": "EligibilityCriterionItem"
      },
      "confidence": 0.85,
      "source_pages": [
